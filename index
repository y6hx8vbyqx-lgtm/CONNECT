<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CZHMessenger - Вход</title>
    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-firestore-compat.js"></script>
    <!-- reCAPTCHA для телефона -->
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        body {
            background: #000;
            color: #fff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .auth-container {
            width: 100%;
            max-width: 400px;
        }

        .logo {
            text-align: center;
            margin-bottom: 40px;
        }

        .logo h1 {
            font-size: 42px;
            font-weight: 800;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .logo p {
            color: rgba(255, 255, 255, 0.6);
            font-size: 16px;
            line-height: 1.5;
        }

        .auth-card {
            background: rgba(28, 28, 30, 0.9);
            border-radius: 20px;
            padding: 30px;
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }

        .form-title {
            font-size: 24px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 30px;
        }

        /* Стили для табов (телефон/почта) */
        .tabs {
            display: flex;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 4px;
            margin-bottom: 25px;
        }

        .tab {
            flex: 1;
            padding: 12px;
            text-align: center;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
            color: rgba(255, 255, 255, 0.6);
        }

        .tab.active {
            background: rgba(102, 126, 234, 0.2);
            color: #667eea;
        }

        /* Формы */
        .form-container {
            position: relative;
            min-height: 250px;
        }

        .form {
            display: none;
        }

        .form.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .input-group {
            margin-bottom: 20px;
        }

        .input-label {
            display: block;
            font-size: 14px;
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .input-field {
            width: 100%;
            padding: 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            color: white;
            font-size: 16px;
            transition: all 0.2s;
        }

        .input-field:focus {
            outline: none;
            border-color: #667eea;
            background: rgba(255, 255, 255, 0.07);
        }

        .phone-input {
            display: flex;
            gap: 10px;
        }

        .country-code {
            width: 80px;
            flex-shrink: 0;
        }

        .phone-number {
            flex: 1;
        }

        /* Кнопки */
        .btn {
            width: 100%;
            padding: 16px;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s;
            text-align: center;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
        }

        .btn-google {
            background: rgba(255, 255, 255, 0.9);
            color: #000;
        }

        .btn-google:hover {
            background: white;
            transform: translateY(-2px);
        }

        .btn-apple {
            background: #000;
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .btn-apple:hover {
            background: rgba(0, 0, 0, 0.9);
            transform: translateY(-2px);
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }

        /* recaptcha контейнер */
        #recaptcha-container {
            margin: 20px 0;
            display: flex;
            justify-content: center;
        }

        /* OTP форма */
        .otp-container {
            text-align: center;
            display: none;
        }

        .otp-title {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .otp-subtitle {
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 25px;
            font-size: 14px;
        }

        .otp-inputs {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-bottom: 25px;
        }

        .otp-input {
            width: 50px;
            height: 60px;
            font-size: 24px;
            text-align: center;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            color: white;
        }

        .otp-input:focus {
            outline: none;
            border-color: #667eea;
        }

        /* Сообщения */
        .message {
            padding: 12px 16px;
            border-radius: 10px;
            margin: 15px 0;
            font-size: 14px;
            display: none;
            text-align: center;
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from { transform: translateY(-10px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .message.success {
            background: rgba(52, 199, 89, 0.15);
            color: #34c759;
            border: 1px solid rgba(52, 199, 89, 0.3);
        }

        .message.error {
            background: rgba(255, 59, 48, 0.15);
            color: #ff3b30;
            border: 1px solid rgba(255, 59, 48, 0.3);
        }

        /* Загрузка */
        .loading {
            text-align: center;
            padding: 20px;
            color: rgba(255, 255, 255, 0.5);
            font-size: 14px;
            display: none;
        }

        .loading span {
            display: inline-block;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }

        /* Адаптивность */
        @media (max-width: 480px) {
            .auth-card {
                padding: 20px;
            }
            
            .logo h1 {
                font-size: 36px;
            }
            
            .form-title {
                font-size: 22px;
            }
            
            .otp-input {
                width: 45px;
                height: 55px;
            }
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="logo">
            <h1>CZH Messenger</h1>
            <p>Безопасный мессенджер с защищённой связью</p>
        </div>
        
        <div class="auth-card">
            <h2 class="form-title">Вход в мессенджер</h2>
            
            <!-- Табы выбора способа входа -->
            <div class="tabs">
                <div class="tab active" data-tab="phone">📱 Телефон</div>
                <div class="tab" data-tab="email">✉️ Email</div>
            </div>
            
            <!-- Контейнер для форм -->
            <div class="form-container">
                <!-- Форма телефона -->
                <div id="phone-form" class="form active">
                    <div class="input-group">
                        <label class="input-label">Номер телефона</label>
                        <div class="phone-input">
                            <select id="country-code" class="input-field country-code">
                                <option value="+7">+7 RU</option>
                                <option value="+380">+380 UA</option>
                                <option value="+375">+375 BY</option>
                                <option value="+1">+1 US</option>
                                <option value="+44">+44 UK</option>
                                <option value="+49">+49 DE</option>
                                <option value="+33">+33 FR</option>
                            </select>
                            <input type="tel" id="phone-number" class="input-field phone-number" 
                                   placeholder="XXX-XXX-XX-XX" maxlength="15">
                        </div>
                    </div>
                    <div id="recaptcha-container"></div>
                    <button class="btn btn-primary" onclick="sendPhoneCode()" id="send-code-btn">
                        Получить код
                    </button>
                </div>
                
                <!-- Форма email -->
                <div id="email-form" class="form">
                    <div class="input-group">
                        <label class="input-label">Email</label>
                        <input type="email" id="email" class="input-field" placeholder="your@email.com">
                    </div>
                    <div class="input-group">
                        <label class="input-label">Пароль</label>
                        <input type="password" id="password" class="input-field" placeholder="••••••••">
                    </div>
                    <button class="btn btn-primary" onclick="emailLogin()" id="email-login-btn">
                        Войти
                    </button>
                    <div class="input-group" style="text-align: center; margin-top: 15px;">
                        <a href="#" style="color: #667eea; font-size: 14px;" onclick="resetPassword()">
                            Забыли пароль?
                        </a>
                    </div>
                </div>
                
                <!-- Форма OTP -->
                <div id="otp-form" class="otp-container">
                    <h3 class="otp-title">Подтверждение кода</h3>
                    <p class="otp-subtitle" id="otp-phone-number">Код отправлен на +7 XXX XXX-XX-XX</p>
                    
                    <div class="otp-inputs">
                        <input type="text" class="otp-input" maxlength="1" data-index="0">
                        <input type="text" class="otp-input" maxlength="1" data-index="1">
                        <input type="text" class="otp-input" maxlength="1" data-index="2">
                        <input type="text" class="otp-input" maxlength="1" data-index="3">
                        <input type="text" class="otp-input" maxlength="1" data-index="4">
                        <input type="text" class="otp-input" maxlength="1" data-index="5">
                    </div>
                    
                    <p class="otp-subtitle" id="countdown">Повторно отправить код через 60 сек</p>
                    <button class="btn btn-primary" onclick="verifyPhoneCode()" id="verify-btn">
                        Подтвердить
                    </button>
                    <button class="btn" onclick="backToPhoneForm()" 
                            style="background: none; color: #667eea; margin-top: 10px;">
                        Изменить номер
                    </button>
                </div>
            </div>
            
            <!-- Разделитель -->
            <div style="text-align: center; margin: 25px 0; position: relative;">
                <div style="border-top: 1px solid rgba(255, 255, 255, 0.1); position: absolute; top: 50%; left: 0; right: 0;"></div>
                <span style="background: rgba(28, 28, 30, 0.9); padding: 0 15px; color: rgba(255, 255, 255, 0.5); font-size: 14px;">
                    или войти через
                </span>
            </div>
            
            <!-- Социальные кнопки -->
            <button class="btn btn-google" onclick="googleLogin()" id="google-btn">
                <svg width="18" height="18" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                Продолжить с Google
            </button>
            
            <button class="btn btn-apple" onclick="appleLogin()" id="apple-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                    <path d="M17.05 20.28c-.98.95-2.05.86-3.08.38-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.38C2.79 15.59 3.51 7.08 9.05 6.72c1.79.07 3.04 1.2 3.7 1.2.64 0 2.01-1.47 3.78-1.25 1.63.17 2.88 1 3.62 2.46-3.21 1.93-2.38 6.63.48 8.09-.57 1.5-1.31 2.99-2.58 4.06zM12.03 6.48c-.16-2.04 1.64-3.83 3.74-4.1.42 2.25-1.84 4.18-3.74 4.1z"/>
                </svg>
                Продолжить с Apple
            </button>
        </div>
        
        <!-- Сообщения -->
        <div id="message" class="message"></div>
        
        <!-- Загрузка -->
        <div id="loading" class="loading">
            <span>Загрузка...</span>
        </div>
        
        <!-- Ссылка на регистрацию -->
        <div style="text-align: center; margin-top: 20px;">
            <span style="color: rgba(255, 255, 255, 0.6); font-size: 14px;">
                Нет аккаунта? 
            </span>
            <a href="#" style="color: #667eea; font-weight: 600;" onclick="showRegister()">
                Зарегистрироваться
            </a>
        </div>
    </div>

    <script>
        // ========== КОНФИГУРАЦИЯ ==========
        // 🔒 ЗАМЕНИТЕ ЭТИ ДАННЫЕ НА СВОИ!
        const FIREBASE_CONFIG = {
            apiKey: "AIzaSyBn-gM0CM2NPMGZ6OpytlPkiIOSIm54hcY",
            authDomain: "czhmass.firebaseapp.com",
            projectId: "czhmass",
            storageBucket: "czhmass.firebasestorage.app",
            messagingSenderId: "1064257019843",
            appId: "1:1064257019843:web:65488b45be2f86838ca776"
        };
        
        const RECAPTCHA_SITE_KEY = "ВАШ_RECAPTCHA_SITE_KEY"; // Получите на Google Cloud Console
        const APPLE_CLIENT_ID = "ваш.apple.services.id"; // Пример: com.example.web.auth
        const APPLE_REDIRECT_URI = "https://ваш-сайт.com/auth/apple/callback";
        
        // ========== ИНИЦИАЛИЗАЦИЯ ==========
        let auth, db;
        let confirmationResult = null;
        let phoneNumber = "";
        let countdownInterval = null;
        let countdownTime = 60;
        
        // Инициализация Firebase
        if (!firebase.apps.length) {
            firebase.initializeApp(FIREBASE_CONFIG);
            console.log('✅ Firebase инициализирован');
        }
        auth = firebase.auth();
        db = firebase.firestore();
        
        // ========== UI ФУНКЦИИ ==========
        function showMessage(text, type = 'info') {
            const messageDiv = document.getElementById('message');
            messageDiv.textContent = text;
            messageDiv.className = 'message ' + type;
            messageDiv.style.display = 'block';
            
            setTimeout(() => {
                messageDiv.style.display = 'none';
            }, 4000);
        }
        
        function showLoading(show) {
            document.getElementById('loading').style.display = show ? 'block' : 'none';
        }
        
        function enableButton(buttonId, enable) {
            const btn = document.getElementById(buttonId);
            if (btn) btn.disabled = !enable;
        }
        
        // Переключение табов телефон/email
        document.querySelectorAll('.tab').forEach(tab => {
            tab.addEventListener('click', () => {
                const tabType = tab.dataset.tab;
                
                // Обновляем активный таб
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                
                // Показываем соответствующую форму
                document.querySelectorAll('.form').forEach(form => form.classList.remove('active'));
                document.getElementById(`${tabType}-form`).classList.add('active');
                
                // Скрываем OTP форму если она была открыта
                document.getElementById('otp-form').style.display = 'none';
            });
        });
        
        // Автопереход между OTP полями
        document.querySelectorAll('.otp-input').forEach(input => {
            input.addEventListener('input', (e) => {
                const value = e.target.value;
                const index = parseInt(e.target.dataset.index);
                
                if (value.length === 1 && index < 5) {
                    document.querySelector(`.otp-input[data-index="${index + 1}"]`).focus();
                }
                
                // Автоподтверждение при заполнении всех полей
                const allFilled = Array.from(document.querySelectorAll('.otp-input'))
                    .every(input => input.value.length === 1);
                
                if (allFilled) {
                    verifyPhoneCode();
                }
            });
            
            // Обработка backspace
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !input.value && parseInt(input.dataset.index) > 0) {
                    document.querySelector(`.otp-input[data-index="${parseInt(input.dataset.index) - 1}"]`).focus();
                }
            });
        });
        
        // ========== АУТЕНТИФИКАЦИЯ ПО ТЕЛЕФОНУ ==========
        let recaptchaVerifier;
        
        function initRecaptcha() {
            recaptchaVerifier = new firebase.auth.RecaptchaVerifier('recaptcha-container', {
                'size': 'normal',
                'callback': (response) => {
                    console.log('reCAPTCHA пройдена');
                    enableButton('send-code-btn', true);
                },
                'expired-callback': () => {
                    showMessage('reCAPTCHA истекла. Попробуйте снова.', 'error');
                    enableButton('send-code-btn', false);
                }
            }, auth);
            
            recaptchaVerifier.render();
        }
        
        // Инициализируем reCAPTCHA при загрузке
        window.onload = function() {
            initRecaptcha();
        };
        
        async function sendPhoneCode() {
            const countryCode = document.getElementById('country-code').value;
            const phoneNum = document.getElementById('phone-number').value;
            
            if (!phoneNum || phoneNum.length < 10) {
                showMessage('Введите корректный номер телефона', 'error');
                return;
            }
            
            phoneNumber = countryCode + phoneNum.replace(/\D/g, '');
            
            try {
                showLoading(true);
                enableButton('send-code-btn', false);
                
                // Отправляем SMS с кодом
                confirmationResult = await auth.signInWithPhoneNumber(
                    phoneNumber, 
                    recaptchaVerifier
                );
                
                // Показываем OTP форму
                document.getElementById('phone-form').style.display = 'none';
                document.getElementById('otp-form').style.display = 'block';
                document.getElementById('otp-phone-number').textContent = 
                    `Код отправлен на ${formatPhoneNumber(phoneNumber)}`;
                
                // Запускаем таймер повторной отправки
                startCountdown();
                
                // Фокус на первом OTP поле
                document.querySelector('.otp-input[data-index="0"]').focus();
                
                showMessage('Код отправлен! Проверьте SMS', 'success');
                
            } catch (error) {
                console.error('Ошибка отправки кода:', error);
                
                let errorMessage = 'Ошибка отправки SMS';
                if (error.code === 'auth/invalid-phone-number') {
                    errorMessage = 'Неверный формат номера';
                } else if (error.code === 'auth/quota-exceeded') {
                    errorMessage = 'Превышен лимит запросов';
                }
                
                showMessage(errorMessage, 'error');
                recaptchaVerifier.render(); // Перерисовываем reCAPTCHA
            } finally {
                showLoading(false);
                enableButton('send-code-btn', true);
            }
        }
        
        function startCountdown() {
            countdownTime = 60;
            const countdownElement = document.getElementById('countdown');
            
            if (countdownInterval) clearInterval(countdownInterval);
            
            countdownInterval = setInterval(() => {
                countdownTime--;
                countdownElement.textContent = `Повторно отправить код через ${countdownTime} сек`;
                
                if (countdownTime <= 0) {
                    clearInterval(countdownInterval);
                    countdownElement.innerHTML = 
                        '<a href="#" style="color:#667eea" onclick="resendCode()">Отправить код повторно</a>';
                }
            }, 1000);
        }
        
        function resendCode() {
            recaptchaVerifier.clear();
            initRecaptcha();
            sendPhoneCode();
        }
        
        function backToPhoneForm() {
            document.getElementById('otp-form').style.display = 'none';
            document.getElementById('phone-form').style.display = 'block';
            if (countdownInterval) clearInterval(countdownInterval);
        }
        
        async function verifyPhoneCode() {
            const otpInputs = document.querySelectorAll('.otp-input');
            const code = Array.from(otpInputs).map(input => input.value).join('');
            
            if (code.length !== 6) {
                showMessage('Введите 6-значный код', 'error');
                return;
            }
            
            try {
                showLoading(true);
                enableButton('verify-btn', false);
                
                // Подтверждаем код
                const userCredential = await confirmationResult.confirm(code);
                
                showMessage('Успешный вход!', 'success');
                
                // Сохраняем пользователя в Firestore
                await saveUserToFirestore(userCredential.user, 'phone');
                
                // Перенаправляем в мессенджер
                setTimeout(() => {
                    window.location.href = '/chat.html';
                }, 1000);
                
            } catch (error) {
                console.error('Ошибка подтверждения кода:', error);
                showMessage('Неверный код. Попробуйте снова.', 'error');
                
                // Сбрасываем OTP поля
                otpInputs.forEach(input => input.value = '');
                document.querySelector('.otp-input[data-index="0"]').focus();
                
            } finally {
                showLoading(false);
                enableButton('verify-btn', true);
            }
        }
        
        // ========== GOOGLE АУТЕНТИФИКАЦИЯ ==========
        async function googleLogin() {
            try {
                showLoading(true);
                enableButton('google-btn', false);
                
                const provider = new firebase.auth.GoogleAuthProvider();
                provider.addScope('profile');
                provider.addScope('email');
                
                const userCredential = await auth.signInWithPopup(provider);
                
                showMessage(`Добро пожаловать, ${userCredential.user.displayName}!`, 'success');
                
                await saveUserToFirestore(userCredential.user, 'google');
                
                setTimeout(() => {
                    window.location.href = '/chat.html';
                }, 1000);
                
            } catch (error) {

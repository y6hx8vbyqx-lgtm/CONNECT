        // ========== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ==========
        function validateEmail(email) {
            const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return re.test(email);
        }
        
        function formatPhoneNumber(phone) {
            // Форматирование +79991234567 -> +7 999 123-45-67
            const cleaned = phone.replace(/\D/g, '');
            const country = cleaned.substring(0, 2);
            const number = cleaned.substring(2);
            
            if (number.length === 10) {
                return `${country} ${number.substring(0, 3)} ${number.substring(3, 6)}-${number.substring(6, 8)}-${number.substring(8)}`;
            }
            return phone;
        }
        
        async function saveUserToFirestore(user, provider) {
            try {
                const userRef = db.collection('users').doc(user.uid);
                const userDoc = await userRef.get();
                
                if (!userDoc.exists) {
                    // Создаем нового пользователя
                    await userRef.set({
                        uid: user.uid,
                        email: user.email || null,
                        phoneNumber: user.phoneNumber || phoneNumber || null,
                        displayName: user.displayName || `User_${user.uid.substring(0, 8)}`,
                        photoURL: user.photoURL || null,
                        provider: provider,
                        createdAt: firebase.firestore.FieldValue.serverTimestamp(),
                        lastLogin: firebase.firestore.FieldValue.serverTimestamp(),
                        status: 'online'
                    });
                    
                    console.log('✅ Новый пользователь сохранен в Firestore');
                } else {
                    // Обновляем время последнего входа
                    await userRef.update({
                        lastLogin: firebase.firestore.FieldValue.serverTimestamp(),
                        status: 'online'
                    });
                    
                    console.log('✅ Пользователь обновлен в Firestore');
                }
                
            } catch (error) {
                console.error('Ошибка сохранения в Firestore:', error);
            }
        }
        
